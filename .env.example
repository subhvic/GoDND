# ---- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose: bypasses RLS. Used by webhooks and payout jobs.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Hosting / multi-tenancy ---------------------------------------------
# Apex the SaaS itself runs on. app.<this> = operator dashboard.
NEXT_PUBLIC_ROOT_DOMAIN=godnd.co
# Wildcard apex that free-tier tenant sites get: {agency-slug}.<this>
NEXT_PUBLIC_TENANT_DOMAIN=godnd.site

# ---- Vercel domain API (custom-domain attachment + TLS) ------------------
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_API_TOKEN=

# ---- Payments (Razorpay: UPI + Route split-settlement for commission) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
